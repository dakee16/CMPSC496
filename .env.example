# MicroTutor configuration. NO SECRETS IN THIS FILE.
# Copy to .env and fill in real values locally; never commit .env.
#
# Every variable below is one the RUNNING CODE reads, with the file and line
# that reads it. Anything not listed here does nothing - see the last section.

# ── required: the app refuses to work without these ──────────────────────

# Signs the session cookie (main/auth.py:54). Generate ours alone:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Sign-in returns 503 rather than signing cookies with "", which anyone could
# then forge (frontend/api_server.py:35). Changing it signs everyone out.
MICROTUTOR_SESSION_SECRET=

# Supabase project + anon key (frontend/api_server.py:52). Every table write -
# students, problems, solved, student_interactions - goes through this key, so
# whatever RLS allows the anon role is what this server can do.
SUPABASE_URL=
SUPABASE_KEY=

# Every system-role model call (main/ollama_client.py:99): decomposition,
# oracle-input generation, grading judges, the tutor, the vision reviewer.
OPENAI_API_KEY=

# development | staging | production. ONLY effect in live code: anything other
# than the literal "dev" makes the session cookie Secure
# (frontend/api_server.py:32). Set it to production on the real server, or
# sessions ride over plain http.
MICROTUTOR_ENV=dev

# ── required in a container: writable paths on the MOUNTED VOLUME ─────────
# start.sh refuses to boot if any of these is unset or points inside the image,
# because a redeploy would silently discard it. Locally, plain data/ is fine.
#
# The oracle cache is the one that hurts: main/grading.py:371 loads every
# problem's tests from it, and regenerating one costs minutes of paid model
# work. start.sh seeds an empty volume from the copy in the repo on first boot.
MICROTUTOR_SESSION_DB=data/grading_sessions.sqlite3      # main/sessions.py:62
MICROTUTOR_ORACLE_CACHE=data/oracles/tests_cache.json    # main/oracle_store.py:23
MICROTUTOR_TRANSCRIPTS=data/transcripts.json             # main/transcripts.py:61

# ── read by docker-compose.yml and Caddyfile, NOT by Python ──────────────
# Only needed on the server. Ignore both when running locally.

# The hostname the TLS certificate is issued for. Caddy gets and renews it from
# Let's Encrypt automatically, so this must be a real name with an A record
# pointing at the server - a bare IP cannot be certified.
MICROTUTOR_DOMAIN=

# Space-separated CIDRs allowed to reach the app; everything else gets a 403
# naming the VPN. This is the network fence auth.py's header assumes exists -
# registration only checks that an address ENDS WITH psu.edu (main/auth.py:122),
# with no confirmation email, so on a public URL anyone can reach the code
# runner. Empty/unset defaults to "allow everything" so the site works before
# PSU IT sends the ranges; narrow it as soon as you have them.
#   MICROTUTOR_ALLOWED_CIDRS=128.118.0.0/16 146.186.0.0/16
MICROTUTOR_ALLOWED_CIDRS=

# ── optional: sensible defaults, override only to change behaviour ────────

# Which email domains may REGISTER (main/auth.py:51). Suffix match, so campus
# and college subdomains (engr.psu.edu) are included.
MICROTUTOR_ALLOWED_DOMAINS=psu.edu

# Brute-force limit, PER ACCOUNT over a sliding window of seconds
# (main/auth.py:68-69). Per account, not per IP, because the VPN puts a whole
# lab behind one address. NOTE: the counter is a per-process dict
# (main/auth.py:294), so it only holds with a single worker - see start.sh.
MICROTUTOR_LOGIN_FAIL_LIMIT=5
MICROTUTOR_LOGIN_FAIL_WINDOW=900

# Models, all in main/ollama_client.py. A value containing ":" is routed to
# local Ollama instead of OpenAI (that colon is the whole routing rule), so
# keep these as plain OpenAI names.
MICROTUTOR_MODEL=gpt-4o-mini            # :35  oracle-input generation
MICROTUTOR_DECOMPOSE_MODEL=gpt-4o       # :55  once per problem, at upload
MICROTUTOR_GRADING_MODEL=gpt-4o         # :56  every Tier 3/4 attempt - the
                                        #      knob to turn down for cost
MICROTUTOR_TUTOR_MODEL=gpt-4o           # :62  per student message
MICROTUTOR_VISION_MODEL=gpt-4o          # :67  design-diagram review

# Only used when the pages are served from somewhere OTHER than this app
# (frontend/api_server.py:113). api_server serves frontend/ itself, so in a
# normal deploy the browser is same-origin and this goes unused.
MICROTUTOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Append every model call to a JSONL file (main/trace.py:46). Unset = keep the
# last 10k in memory only. Point it at the volume if you want it to survive.
MICROTUTOR_TRACE_FILE=

# ── NOT WIRED UP - setting these changes nothing ──────────────────────────
# main/config.py defines a full typed config with production validation
# ("production refuses the SQLite store / the local runner / wildcard CORS"),
# but NOTHING IMPORTS IT. Its guarantees do not run, and these variables are
# read only by that module:
#
#   DATABASE_URL, DB_POOL_MIN, DB_POOL_MAX, DB_STATEMENT_TIMEOUT_MS,
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_AUDIENCE, SUPABASE_JWT_ISSUER,
#   MICROTUTOR_ROLE_CLAIM, MICROTUTOR_ALLOW_ANONYMOUS,
#   MICROTUTOR_ADAPTER_MODEL, MICROTUTOR_JUDGE_MODEL, MICROTUTOR_VERIFIER_MODEL,
#   MICROTUTOR_LLM_TIMEOUT, MICROTUTOR_LLM_RETRIES, MICROTUTOR_LLM_CIRCUIT_BREAK,
#   MICROTUTOR_EXECUTION_BACKEND, MICROTUTOR_RUNNER_IMAGE,
#   MICROTUTOR_CONTAINER_RUNTIME, MICROTUTOR_ALLOW_UNSAFE_LOCAL_EXECUTION,
#   MICROTUTOR_MAX_REQUEST_BYTES, MICROTUTOR_MAX_CODE_BYTES,
#   MICROTUTOR_SESSION_TTL_HOURS, MICROTUTOR_MAX_SESSIONS, MICROTUTOR_SUBMIT_RPM,
#   MICROTUTOR_LOG_LEVEL, MICROTUTOR_LOG_JSON, MICROTUTOR_REDACT_CODE
#
# In particular: student code runs in the hardened LOCAL harness
# (main/execution.py), never a container, whatever MICROTUTOR_EXECUTION_BACKEND
# says. The container boundary IS the isolation. Either wire config.get() into
# startup or delete the module - do not configure against it.

