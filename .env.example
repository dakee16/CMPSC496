# MicroTutor backend configuration. NO SECRETS IN THIS FILE.
# Copy to .env and fill in real values locally; never commit .env.

# ── environment ──────────────────────────────────────────────────────────
# development | staging | production
# production refuses: anonymous identity, the SQLite store, the local
# in-process runner, and wildcard CORS.
# Anything other than "dev" also makes the session cookie Secure, so set this
# on the real server or sessions ride over plain http - which the VPN does not
# fix, because every other student is on the VPN too.
MICROTUTOR_ENV=development
# Only needed when the pages are served from somewhere OTHER than this app.
# api_server.py serves frontend/ itself, so in production the browser is
# same-origin and this list goes unused.
MICROTUTOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── sign-in (username + password; see main/auth.py) ──────────────────────
# Signs the session cookie. 64 random hex chars, ours alone, never shared:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Sign-in refuses to serve without it rather than signing cookies with "",
# which anyone could then forge. Changing it signs everyone out.
MICROTUTOR_SESSION_SECRET=
# Which email domains may REGISTER. Suffix match, so campus and college
# subdomains (engr.psu.edu) are included.
MICROTUTOR_ALLOWED_DOMAINS=psu.edu
# Brute-force limit, counted PER ACCOUNT over a sliding window of seconds.
# Per account, not per IP, because the VPN puts a whole lab behind one address
# and an IP limit would let one person's typos lock out everyone near them.
# The lock lifts itself when the oldest failure ages out - nobody unlocks it.
MICROTUTOR_LOGIN_FAIL_LIMIT=5
MICROTUTOR_LOGIN_FAIL_WINDOW=900

# ── database ─────────────────────────────────────────────────────────────
# Empty DATABASE_URL selects the SQLite development adapter.
DATABASE_URL=
MICROTUTOR_SESSION_DB=data/grading_sessions.sqlite3
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# ── Supabase auth ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=                       # anon key (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY - never sent to a browser
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
# Where the instructor/admin role lives on the Supabase JWT.
MICROTUTOR_ROLE_CLAIM=app_metadata.role
# DEV ONLY. Forbidden in production; startup fails if set there.
MICROTUTOR_ALLOW_ANONYMOUS=false

# ── LLM (Tier 3 adapter + Tier 4 judges) ─────────────────────────────────
OPENAI_API_KEY=
MICROTUTOR_ADAPTER_MODEL=gpt-4o-mini
MICROTUTOR_JUDGE_MODEL=gpt-4o-mini
MICROTUTOR_VERIFIER_MODEL=gpt-4o-mini
MICROTUTOR_LLM_TIMEOUT=30
MICROTUTOR_LLM_RETRIES=2
MICROTUTOR_LLM_CIRCUIT_BREAK=5

# ── execution backend ────────────────────────────────────────────────────
# local_process (dev only) | container (required in production)
MICROTUTOR_EXECUTION_BACKEND=local_process
MICROTUTOR_RUNNER_IMAGE=microtutor-runner:latest
MICROTUTOR_CONTAINER_RUNTIME=docker
# Deliberate, auditable override. Leave false.
MICROTUTOR_ALLOW_UNSAFE_LOCAL_EXECUTION=false

# ── limits / abuse controls ──────────────────────────────────────────────
MICROTUTOR_MAX_REQUEST_BYTES=262144
MICROTUTOR_MAX_CODE_BYTES=32768
MICROTUTOR_SESSION_TTL_HOURS=12
MICROTUTOR_MAX_SESSIONS=5
MICROTUTOR_SUBMIT_RPM=12

# ── logging ──────────────────────────────────────────────────────────────
MICROTUTOR_LOG_LEVEL=INFO
MICROTUTOR_LOG_JSON=true
MICROTUTOR_REDACT_CODE=true
