# Caddyfile - TLS, and an OPTIONAL network fence.
#
# The PSU-VPN allowlist was dropped deliberately: access is gated in the app by
# an explicit roster (MICROTUTOR_ALLOWED_EMAILS, main/auth.py:130), which is
# checked on registration, on sign-in, and on every request carrying a cookie.
# That is a stronger control than source IP, and it does not care where a
# student is sitting.
#
# The matcher below stays because it costs nothing and defaults to "allow
# everything" (docker-compose.yml). Set MICROTUTOR_ALLOWED_CIDRS only if you
# later want to narrow the network too.
#
# PORT 80 MUST STAY OPEN TO THE WORLD in the server firewall. The Let's Encrypt
# challenge arrives from their validation servers, not from campus.

{$MICROTUTOR_DOMAIN} {
	# Space-separated CIDRs, from MICROTUTOR_ALLOWED_CIDRS, e.g.
	#     MICROTUTOR_ALLOWED_CIDRS=128.118.0.0/16 146.186.0.0/16
	# Defaults to everything (docker-compose.yml) so the site is reachable
	# before PSU IT answers. Narrow it as soon as you have the real ranges.
	@campus remote_ip {$MICROTUTOR_ALLOWED_CIDRS}

	handle @campus {
		reverse_proxy app:8000
	}

	# An explicit refusal, not a timeout: "the site is broken" and "you are not
	# on the VPN" must not look the same to a student at 2am.
	handle {
		respond "Not available from this network. Connect to the Penn State VPN and reload." 403
	}

	# On by default so you can VERIFY the fence actually sees real client IPs.
	# Docker publishes 80/443 with an iptables DNAT that normally preserves the
	# source address, but if these logs show 172.x.x.x for every request then
	# Caddy is matching the Docker gateway, the allowlist is meaningless, and
	# the proxy needs host networking instead. Check before you narrow the CIDRs.
	log {
		output stdout
		format console
	}
}
