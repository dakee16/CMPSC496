# Copy to k8s/secrets/deploy.env (gitignored) and fill in. Read by
# k8s/scripts/deploy.sh; none of it reaches the app.

# The hostname the site answers on. With no DNS name yet, use the server's IP
# through nip.io, e.g. 203.0.113.7.nip.io, together with TLS_ISSUER=selfsigned.
ACADIA_HOST=

# selfsigned | letsencrypt-staging | letsencrypt  (k8s/cluster/issuers.yaml)
# The two ACME issuers need ACME_EMAIL, a real DNS name and port 80 open.
TLS_ISSUER=selfsigned
ACME_EMAIL=

# test = Postgres runs in the cluster (DATABASE_URL is generated for you).
# production = DATABASE_URL in k8s/secrets/app.env, runner under gVisor.
OVERLAY=test

# Usually left empty: deploy.sh uses the image build-image.sh made last.
# Set it to roll back, e.g. IMAGE=acadia:3f2a9c1
IMAGE=
